# NVIDIA NIM API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here

# Model Endpoints / IDs (NVIDIA NIM)
BIBLE_EXTRACTION_MODEL=qwq-32b
EMBEDDING_MODEL=nvidia/bge-m3
REWRITE_STANDARD_MODEL=meta/llama-3.3-70b-instruct
REWRITE_LONG_MODEL=deepseek-v3.1
VALIDATION_MODEL=gliner-pii

# Processing Settings
CHUNK_SIZE=4000
CHUNK_OVERLAP=400
MAX_LONG_CHUNK_THRESHOLD=5000

# File Paths
RAW_CHAPTERS_DIR=chapters/raw
REWRITTEN_CHAPTERS_DIR=chapters/rewritten
BIBLE_DIR=bibles
PROGRESS_FILE=progress.json
